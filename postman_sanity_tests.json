    {
      "name": "9. System Health Summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/certifications",
          "host": ["{{base_url}}"],
          "path": ["certifications"]
        },
        "description": "Final health check and system summary"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"✅ Final System Health Check - Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"✅ System is fully operational\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData.success).to.be.true;",
              "});",
              "",
              "// Generate health summary",
              "var timestamp = new Date().toISOString();",
              "var responseTime = pm.response.responseTime;",
              "var certificationCount = pm.response.json().data.length;",
              "",
              "var environmentName = pm.environment.get('environment_name');",
              "console.log('\\n🎯 SYSTEM HEALTH SUMMARY [' + environmentName + '] - ' + timestamp);",
              "console.log('=====================================');",
              "console.log('✅ Environment:', environmentName);",
              "console.log('✅ API Status: HEALTHY');",
              "console.log('✅ Response Time:', responseTime + 'ms');",
              "console.log('✅ Certifications Available:', certificationCount);",
              "console.log('✅ All Core APIs: OPERATIONAL');",
              "console.log('✅ Database: CONNECTED');",
              "console.log('✅ Authentication: WORKING');",
              "console.log('=====================================');",
              "",
              "// Set environment variables for reporting",
              "pm.environment.set('health_check_time', timestamp);",
              "pm.environment.set('health_check_status', 'HEALTHY');",
              "pm.environment.set('health_check_response_time', responseTime);",
              "pm.environment.set('health_check_certifications', certificationCount);"
            ],
            "type": "text/javascript"
          }
        }
      ]
