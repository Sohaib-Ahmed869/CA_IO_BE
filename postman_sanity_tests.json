{
  "info": {
    "name": "CA IO Backend - Sanity Tests",
    "description": "Quick sanity tests for monitoring API health - Run every 12 PM via Airflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "test_user_email",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "test_user_password",
      "value": "TestPass123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check - Get Certifications",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/certifications",
          "host": ["{{base_url}}"],
          "path": ["certifications"]
        },
        "description": "Health check - Verify API is responding and certifications are available"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"✅ API Health Check - Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"✅ Response has success property\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData.success).to.be.true;",
              "});",
              "",
              "pm.test(\"✅ Certifications data is available\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('data');",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "    pm.expect(jsonData.data.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"✅ Response time is acceptable (< 3000ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "pm.test(\"✅ At least one active certification exists\", function () {",
              "    var jsonData = pm.response.json();",
              "    var hasActiveCert = jsonData.data.some(cert => cert.isActive === true);",
              "    pm.expect(hasActiveCert).to.be.true;",
              "});",
              "",
              "// Save certification ID for other tests",
              "if (pm.response.json().success && pm.response.json().data.length > 0) {",
              "    var firstActiveCert = pm.response.json().data.find(cert => cert.isActive === true);",
              "    if (firstActiveCert) {",
              "        pm.environment.set('certification_id', firstActiveCert._id);",
              "    }",
              "}",
              "",
              "console.log('✅ [' + pm.environment.get('environment_name') + '] Certifications API is healthy -', pm.response.json().data.length, 'certifications found');"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
