          "host": ["{{base_url}}"],
          "path": ["admin", "applications"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": "Test applications API - Get first page of applications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"✅ Applications - Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"✅ Applications response has success property\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData.success).to.be.true;",
              "});",
              "",
              "pm.test(\"✅ Applications response has correct structure\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('data');",
              "    pm.expect(jsonData.data).to.have.property('applications');",
              "    pm.expect(jsonData.data).to.have.property('pagination');",
              "});",
              "",
              "pm.test(\"✅ Pagination structure is correct\", function () {",
              "    var jsonData = pm.response.json();",
              "    var pagination = jsonData.data.pagination;",
              "    pm.expect(pagination).to.have.property('current');",
              "    pm.expect(pagination).to.have.property('pages');",
              "    pm.expect(pagination).to.have.property('total');",
              "    pm.expect(pagination).to.have.property('limit');",
              "});",
              "",
              "pm.test(\"✅ Applications response time is acceptable (< 3000ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "// Save first application ID if available",
              "if (pm.response.json().success && pm.response.json().data.applications.length > 0) {",
              "    pm.environment.set('application_id', pm.response.json().data.applications[0]._id);",
              "    console.log('✅ [' + pm.environment.get('environment_name') + '] Applications API is healthy -', pm.response.json().data.pagination.total, 'total applications');",
              "} else {",
              "    console.log('✅ [' + pm.environment.get('environment_name') + '] Applications API is healthy - No applications found');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
