              "console.log('✅ [' + pm.environment.get('environment_name') + '] Authentication system is healthy - User:', pm.response.json().data.email);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Applications - Get Applications List",
