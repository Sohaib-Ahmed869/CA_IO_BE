  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set environment name for logging",
          "if (!pm.environment.get('environment_name')) {",
          "    pm.environment.set('environment_name', 'Unknown Environment');",
          "}",
          "",
          "console.log('🚀 [' + pm.environment.get('environment_name') + '] Starting sanity tests...');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level test summary",
          "console.log('📊 [' + pm.environment.get('environment_name') + '] Test Summary:');",
          "console.log('   Total Tests:', pm.info.requestCount);",
          "console.log('   Passed:', pm.info.passedTests);",
          "console.log('   Failed:', pm.info.failedTests);",
          "",
          "if (pm.info.failedTests > 0) {",
          "    console.log('❌ [' + pm.environment.get('environment_name') + '] Some tests failed!');",
          "} else {",
          "    console.log('✅ [' + pm.environment.get('environment_name') + '] All tests passed!');",
          "}"
        ]
      }
    }
