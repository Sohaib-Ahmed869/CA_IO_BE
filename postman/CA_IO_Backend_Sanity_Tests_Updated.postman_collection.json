{
  "info": {
    "_postman_id": "40814f00-21ae-4108-ab3b-30b398e72b2c",
    "name": "CA IO Backend - Sanity Tests (Simplified)",
    "description": "Simplified sanity tests for monitoring API health across all environments - Run every 12 PM via Airflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "47061163"
  },
  "item": [
    {
      "name": "0. Login - Get Auth Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status Code 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.token).to.exist;",
              "});",
              "",
              "// Extract and set token for subsequent requests",
              "if (pm.response.json().data && pm.response.json().data.token) {",
              "    var token = pm.response.json().data.token;",
              "    pm.environment.set('auth_token', token);",
              "    console.log('✅ [' + pm.environment.get('environment_name') + '] Login successful');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        },
        "description": "Login to get authentication token for subsequent requests"
      },
      "response": []
    },
